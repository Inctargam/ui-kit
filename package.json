{
  "name": "@remark-gram/ui-kit",
  "version": "0.1.1",
  "description": "React 19 UI component library built on Base UI and CSS Modules",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "base-ui",
    "css-modules",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Inctargam/ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inctargam/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Inctargam/ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/reset.css": "./dist/styles/reset.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -b && vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:pkg": "publint --strict && attw --pack .",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:clean": "node scripts/icons/clean.mjs",
    "icons:build": "node scripts/icons/build.mjs",
    "icons": "pnpm icons:clean && pnpm icons:build"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.5.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "10.5.4",
    "globals": "^17.7.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "10.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

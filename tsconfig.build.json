{
  /* Типы пакета. Vite их не генерирует — он собирает только JS, поэтому .d.ts
     эмитит сам tsc, отдельным шагом после vite build (vite чистит dist перед сборкой,
     запуск наоборот стёр бы типы).

     Отличия от tsconfig.app.json: emit включён, .storybook/ и стори в пакет не входят,
     rootDir=src даёт структуру dist, совпадающую с preserveModules в vite.config.ts. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    /* Инкрементальность выключена намеренно: vite build чистит dist перед сборкой,
       а tsc по своему кешу считал бы типы уже собранными и не переписал бы их. */
    "incremental": false
  },
  "include": ["src"],
  /* Стори лежат рядом с компонентами, но это витрина, а не API пакета: vite build
     их не видит (они недостижимы из src/index.ts), и .d.ts на них тоже не нужны —
     иначе в dist уехали бы типы, ссылающиеся на @storybook/* из devDependencies. */
  "exclude": ["src/**/*.stories.tsx"]
}
